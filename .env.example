# Copy to .env for local development (node scripts/dev-server.js reads it).
# On Vercel / Netlify, set these in the project's Environment Variables settings instead.
# NEVER commit a real .env file. NEVER prefix these with VITE_/NEXT_PUBLIC_/etc.

# --- Image Generation ---
# Optional: Google Gemini API Key (requires a paid/billing project for Gemini image generation quota)
GEMINI_API_KEY=
# Optional: Any Gemini model that can return images via generateContent.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Optional: Image provider ('pollinations' for free unlimited generation, or omit to use Gemini with automatic free fallback)
IMAGE_PROVIDER=pollinations

# Optional: Hugging Face personal access token (Read access)
HF_TOKEN=

# --- Canva Connect (optional; needs a Canva developer integration) ---
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Optional. Defaults to https://<your-host>/api/canva-callback. Must match the redirect URL registered in Canva exactly.
CANVA_REDIRECT_URI=

# --- Adobe Express Embed SDK (optional; client ID is public by design but bound to allowed domains) ---
ADOBE_EXPRESS_CLIENT_ID=
ADOBE_EXPRESS_APP_NAME=AI PrintOS

# --- Optional hardening: comma-separated list of allowed Origin values for POST requests ---
ALLOWED_ORIGINS=
